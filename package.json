{
  "name": "sahiixx-e2e",
  "private": true,
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ai": "playwright test --project=ai",
    "test:e2e:realtime": "playwright test --project=realtime",
    "test:e2e:lead": "playwright test --project=lead-machine",
    "test:e2e:contracts": "playwright test --project=contracts --project=lead-machine",
    "test:e2e:integration": "playwright test --project=integration",
    "test:e2e:models": "playwright test --project=traditional-models --project=generative-models --project=foundation-models",
    "test:e2e:traditional": "playwright test --project=traditional-models",
    "test:e2e:generative": "playwright test --project=generative-models",
    "test:e2e:foundation": "playwright test --project=foundation-models",
    "test:e2e:matrix": "npm run test:e2e:contracts && npm run test:e2e:models",
    "test:e2e:smoke": "playwright test --project=contracts --project=lead-machine",
    "test:live": "LIVE_E2E=1 playwright test --project=ai --project=realtime",
    "check": "tsc --noEmit",
    "db:reset:test": "prisma migrate reset --force --skip-seed",
    "eval": "tsx tools/eval-harness.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@prisma/client": "^5.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.0.0",
    "bcryptjs": "^2.4.3",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "zod": "^3.25.76"
  }
}
